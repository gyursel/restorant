# Server-side only. Configure in Vercel > Project > Settings > Environment Variables.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
ADMIN_EMAIL=owner@example.com
# node scripts/make-password-hash.mjs
ADMIN_PASSWORD_HASH=scrypt:32_hex_salt:128_hex_hash
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_random_hex_characters
